# 주의: git 의 .gitignore 는 "줄 끝 주석"을 지원하지 않는다.
#   state.json   # 보유 포지션   ← 이렇게 쓰면 패턴에 주석까지 포함돼 무시가 깨진다.
# 주석은 반드시 자기 줄에 단독으로 둘 것.

# ── 민감 정보 (절대 커밋 금지) ──────────────────────────────────────────────
.env
*.key
*.pem
# Slack/텔레그램/카카오 토큰, 이메일 비밀번호
notify_config.json

# ── 로컬 상태 / 거래 데이터 (사용자별, 커밋 불필요) ──────────────────────────
# 보유 포지션 (실거래/모의)
state.json
state_paper.json
# 모의투자 가상 현금
paper_account.json
# 거래 내역 (실거래/모의)
trades.json
trades_paper.json
# 주문 로그
orders_log.json
# 일일 손실 킬스위치 상태
day_state.json
# 가격 알림
price_alerts.json
# 매매 규칙 + 가중치
rules_config.json
# 데몬 설정 · 봇 상태 스냅샷 · 워치리스트
autotrader_config.json
bot_status.json
watchlist.json

# ── 캐시 (재생성 가능) ──────────────────────────────────────────────────────
universe_cache.json
stock_db_cache.json
sector_cache.json
__pycache__/
*.pyc
*.pyo

# ── 빌드/배포 산출물 ────────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.dmg
*.dmg.bak-*
.DS_Store

# ── 로그 ────────────────────────────────────────────────────────────────────
*.log

# ── 프로세스 제어 파일 (재생성 가능) ────────────────────────────────────────
scheduler.pid
autotrader.pid
# 프로세스 간 거래 락
.trade.lock

.venv/

# ── 앱 번들 (빌드 산출물) ───────────────────────────────────────────────────
# 주의: 번들 안에 코드 사본과 .env 가 통째로 복사돼 들어간다.
# 예전에 이 경로로 실제 API 키가 공개 저장소에 유출됐다. 반드시 제외.
*.app/
AI 트레이딩.app/

# ── 개인 작업 노트 ──────────────────────────────────────────────────────────
obsidian_notes/
작업정리_옵시디언.md
