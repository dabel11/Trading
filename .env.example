# .env.example — 이 파일을 복사해서 .env 로 저장 후 키 입력
#   cp .env.example .env
# config.py 가 .env 를 자동으로 읽습니다. .env 는 절대 커밋하지 마세요(.gitignore 처리됨).
# 키가 없어도 동작합니다 — yfinance 시세 + 모의(페이퍼) 계좌로 실행됩니다.

# ── Alpaca (미국 주식 주문) ──
# https://alpaca.markets 에서 발급. 없으면 실거래 비활성, 모의투자만 동작.
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
# 페이퍼 트레이딩: https://paper-api.alpaca.markets
# 실거래:         https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Finnhub (실시간 시세) ──
# https://finnhub.io 무료 가입. 넣으면 WebSocket 체결 스트림이 켜집니다.
# 없으면 yfinance 폴링으로 자동 폴백.
FINNHUB_API_KEY=your_finnhub_api_key

# ── 토스증권 오픈 API (사전 신청 → 정식 출시 후 PC 웹에서 키 발급) ──
# 국내+해외 통합. 정식 출시 전까지는 비워두면 자동으로 Alpaca 사용.
TOSS_APP_KEY=your_toss_app_key
TOSS_APP_SECRET=your_toss_app_secret
# TOSS_BASE_URL=https://openapi.tossinvest.com

# 사용할 브로커: alpaca(미국, 기본) | toss(국내+해외, 출시 후)
BROKER=alpaca
